# Local docker-compose settings. Don't edit this file: run `make env` to create .env
# with random values (.env is git-ignored). Never commit real secrets.

POSTGRES_PASSWORD=change-me
SERVICE_DB_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# First admin account (the Command Centre). Change the password.
BOOTSTRAP_ADMIN_EMAIL=admin@drukrescue.bt
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Set to http://lgtm:4318 when running with `--profile obs` (Grafana + Tempo + Loki + Prometheus in one container)
OTEL_EXPORTER_OTLP_ENDPOINT=
